    {
      "parameters": {
        "jsCode": "// Builds the Telegram summary text for a finalized (Save List) request.\n// Input is Compute Totals' own output: { list, total, budget, remaining, cadence }.\nconst { list, total, budget, remaining, cadence } = $json;\nconst lines = list\n  .map((r) => `\\u2022 ${r.item} (x${r.qty}) \\u2014 $${(Number(r.price) * Number(r.qty)).toFixed(2)}`)\n  .join('\\n');\nconst budgetLine = remaining >= 0\n  ? `$${remaining.toFixed(2)} remaining`\n  : `$${Math.abs(remaining).toFixed(2)} over`;\nconst text = `\\uD83D\\uDED2 Household Ledger \\u2014 ${cadence} list finalized:\\n\\n${lines}\\n\\nTotal: $${total.toFixed(2)} of $${budget.toFixed(2)} budget (${budgetLine})`;\nreturn [{ json: { text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        650
      ],
      "id": "code-format-finalize-message",
      "name": "Format Finalize Message"
    },
