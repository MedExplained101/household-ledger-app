    {
      "parameters": {
        "jsCode": "// Builds the Telegram summary text for a finalized (Save List) request.\n// Input is Compute Totals' own output: { list, total, budget, remaining, cadence }.\nconst { list, total, budget, remaining, cadence } = $json;\nconst lines = list\n  .map((r) => `\\u2022 ${r.item} (x${r.qty}) \\u2014 $${(Number(r.price) * Number(r.qty)).toFixed(2)}`)\n  .join('\\n');\nconst budgetLine = remaining >= 0\n  ? `$${remaining.toFixed(2)} remaining`\n  : `$${Math.abs(remaining).toFixed(2)} over`;\nconst text = `\\uD83D\\uDED2 Household Ledger \\u2014 ${cadence} list finalized:\\n\\n${lines}\\n\\nTotal: $${total.toFixed(2)} of $${budget.toFixed(2)} budget (${budgetLine})`;\nreturn [{ json: { text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        650
      ],
      "id": "code-format-finalize-message",
      "name": "Format Finalize Message"
    },
    {
      "parameters": {
        "chatId": "1662316637",
        "operation": "sendMessage",
        "text": "={{ $json.text }}"
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2272,
        650
      ],
      "id": "telegram-send-finalize-summary",
      "name": "Send Finalize Summary",
      "notes": "On Error MUST be set to Continue on this node (Settings tab) -- an unhandled error here would block the whole webhook response the same way Check Budget Alert did before that was fixed earlier tonight, since this sits on a shared execution even though it's a parallel branch. Use the SAME Telegram bot credential already connected for Budget Alert Listener/Check-In Agent (household chat 1662316637), not a new one.",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "REPLACE_WITH_BOT_NAME"
        }
      }
