# Copy to .env for local dev (npm run dev), or set this as an environment
# variable in your hosting provider's dashboard (Netlify: Site settings →
# Environment variables; Vercel: Project settings → Environment Variables).
#
# If unset, the app falls back to the current production n8n webhook hardcoded
# in src/App.jsx — so setting this is optional, but required if you need to
# rotate the webhook URL without a code change/redeploy.
VITE_WEBHOOK_URL=https://medexplained101.app.n8n.cloud/webhook/household-ledger-list
