        "url": "={{ $json.CheckIn_ResumeURL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"lowItems\": $('Parse Reply').first().json.lowItems, \"finishedItems\": $('Parse Reply').first().json.finishedItems } }}"
      },
      "id": "http-call-resume",
      "name": "Call Resume Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        -180
      ],
      "notes": "Wakes the paused 'Wait for Check-In Reply' node in the Check-In Agent, feeding it { lowItems, finishedItems }."
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Reply').first().json.chatId }}",
        "operation": "sendMessage",
        "text": "Got it \u2014 updating inventory now."
      },
      "id": "telegram-ack",
      "name": "Acknowledge Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        540,
        -180
      ],
      "notes": "Lightweight ack \u2014 the Check-In Agent sends its own fuller confirmation once it finishes processing."
    }
  ],
