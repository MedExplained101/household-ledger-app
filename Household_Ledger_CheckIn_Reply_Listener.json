        }
      },
      "id": "if-found-pending",
      "name": "Found Pending Check-In?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        100,
        -80
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Reply').first().json.chatId }}",
        "operation": "sendMessage",
        "text": "No check-in waiting right now \u2014 nothing to update."
      },
      "id": "telegram-no-pending",
      "name": "No Pending Check-In",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
