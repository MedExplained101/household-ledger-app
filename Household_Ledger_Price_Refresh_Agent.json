    {
      "parameters": {
        "jsCode": "// 24-48h freshness gate (CLAUDE.md / architecture.md Section 5): a newly scraped price\n// isn't trusted into Catalog until it's sat unchallenged for PROMOTE_AFTER_HOURS, and only\n// if no newer scrape for the same item+store has landed since (which would supersede it).\nconst PROMOTE_AFTER_HOURS = 36; // middle of the 24-48h range CLAUDE.md specifies; adjust as needed\n\nconst rows = $input.all().map(i => i.json).filter(r => r.item && r.store);\nconst now = DateTime.now();\n\n// Latest row per item+store\nconst latestByKey = new Map();\nfor (const r of rows) {\n  const key = `${r.item}::${r.store}`;\n  const scrapedAt = r.scraped_at ? DateTime.fromISO(String(r.scraped_at)) : null;\n  const existing = latestByKey.get(key);\n  if (!existing || (scrapedAt && scrapedAt > existing._scrapedAt)) {\n    latestByKey.set(key, { ...r, _scrapedAt: scrapedAt });\n  }\n}\n\nconst ready = [];\nfor (const row of latestByKey.values()) {\n  if (row.status !== 'pending') continue;\n  if (!row._scrapedAt || !row._scrapedAt.isValid) continue;\n  const ageHours = now.diff(row._scrapedAt, 'hours').hours;\n  if (ageHours >= PROMOTE_AFTER_HOURS) {\n    ready.push({ item: row.item, store: row.store, price: row.price, date: row.date });\n  }\n}\n\nreturn ready.map(r => ({ json: r }));"
      },
