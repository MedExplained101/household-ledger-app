      "parameters": {
        "jsCode": "// Same gap/staleness-detection shape as BNS's 'Check Buffer & Prepare Generator Input'.\nconst STALE_AFTER_DAYS = 14;\nconst MAX_ITEMS_PER_RUN = 20; // respects the monthly execution-cap warning in CLAUDE.md\n\nconst rows = $input.all().map(i => i.json);\nconst now = DateTime.now();\n\nconst withAge = rows.map(r => {\n  const lu = r.last_updated ? DateTime.fromISO(String(r.last_updated)) : null;\n  const ageDays = lu && lu.isValid ? now.diff(lu, 'days').days : Infinity; // blank/invalid = infinitely stale\n  return { ...r, _ageDays: ageDays };\n});\n\nconst stale = withAge\n  .filter(r => r._ageDays >= STALE_AFTER_DAYS)\n  .sort((a, b) => b._ageDays - a._ageDays)\n  .slice(0, MAX_ITEMS_PER_RUN);\n\nreturn stale.map(r => ({ json: { item: r.item, category: r.category, store: r.store, product_url: r.product_url || '' } }));"
      },
