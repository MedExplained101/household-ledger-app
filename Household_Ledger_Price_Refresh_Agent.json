      "id": "6ff6443f-286b-480b-a239-1807cef1bfdb",
      "name": "Extract Price via LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        176
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "lTKsfwWFUX0Yh2iJ",
          "name": "Antrhopic API Key"
        }
      },
      "notes": "Structured-JSON-only extraction per CLAUDE.md's 'never free text' rule. Same shape ME101 uses for its equivalent agent (~38.5% early failure rate there per the Master Work Log) \u2014 validation happens in the next node, not here. Reads $json.data generically since either upstream branch (known-URL fetch or search fallback) can feed this node."
    },
    {
      "parameters": {
        "jsCode": "// Validates the LLM's extraction against the required schema before it's trusted at all.\n// Never a bare scrape-and-trust path, per CLAUDE.md.\nconst item = $('Loop Over Stale Items').first().json;\nlet parsed;\ntry {\n  const raw = $input.first().json.content?.[0]?.text ?? '';\n  parsed = JSON.parse(raw);\n} catch (e) {\n  return [{ json: { valid: false, item: item.item, store: item.store, reason: 'unparseable JSON from extraction' } }];\n}\n\nconst priceOk = typeof parsed.price === 'number' && parsed.price > 0;\nconst storeOk = typeof parsed.store === 'string' && parsed.store.length > 0;\nconst itemOk = typeof parsed.item === 'string' && parsed.item.length > 0;\n\nif (!priceOk || !storeOk || !itemOk) {\n  return [{ json: { valid: false, item: item.item, store: item.store, reason: 'missing/invalid required field', raw: parsed } }];\n}\n\nreturn [{ json: { valid: true, ...parsed } }];"
      },
