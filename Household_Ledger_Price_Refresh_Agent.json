        "jsonBody": "={{ {\n  \"model\": \"claude-sonnet-5\",\n  \"max_tokens\": 300,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Extract the current price for '\" + $('Loop Over Stale Items').first().json.item + \"' at \" + $('Loop Over Stale Items').first().json.store + \" from this page content (this may be a store product page, or a general web search result page \u2014 look for the most likely official current price either way). Respond with ONLY a JSON object: {\\\"store\\\": string, \\\"item\\\": string, \\\"price\\\": number, \\\"unit_price\\\": number|null, \\\"size\\\": string|null, \\\"unit_label\\\": string|null}. No prose, no markdown fences.\\n\\nPAGE CONTENT:\\n\" + $json.data\n  }]\n} }}",
